---
import CategoryIcon from "../components/CategoryIcon.astro";
import DocsLayout from "../layouts/DocsLayout.astro";
import { site } from "../lib/site";

const description = `About ${site.name} — ${site.shortDescription}`;
---

<DocsLayout title="About" description={description} canonical="/about">
  <article class="page">
    <header class="hero">
      <div class="badge">
        <CategoryIcon name="info" class="size-3.5 text-info" />
        <span class="badge-label">About</span>
      </div>
      <h1>
        About {site.brand.primary}<span class="muted"
          >{site.brand.secondary}</span
        >
      </h1>
      <div class="accent"></div>
      <p class="lede">
        A documentation site for HTTP response status codes — clear, practical
        explanations for developers and webmasters.
      </p>
    </header>

    <div class="prose">
      <p>
        <strong>{site.name}</strong> covers informational, success, redirection, client,
        and server responses so you can look up what a status means and how it shows
        up in practice.
      </p>

      <h2 id="urls">URLs</h2>
      <p>
        Every status is available at both a short and a descriptive path, for
        example <code>/status/100</code> and <code>/status/100-continue</code>.
        They serve the same static page; the descriptive URL is the canonical
        one.
      </p>

      <h2 id="source">Source</h2>
      <p>
        Maintained by{" "}
        <a href={site.owner.github} target="_blank" rel="noopener noreferrer"
          >@{site.owner.name}</a
        >. The project is open source on{" "}
        <a href={site.owner.repo} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >.
      </p>

      <p class="note">
        Inspired by{" "}
        <a href={site.inspiration.url} target="_blank" rel="noopener noreferrer"
          >{site.inspiration.name}</a
        >
        {" "}by{" "}
        <a
          href={site.inspiration.github}
          target="_blank"
          rel="noopener noreferrer">{site.inspiration.handle}</a
        >.
      </p>
    </div>
  </article>
</DocsLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 1rem 1.25rem;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .page {
      padding: 3.5rem 2.5rem 2rem;
    }
  }

  .hero {
    margin-bottom: 2.25rem;
  }

  @media (min-width: 768px) {
    .hero {
      margin-bottom: 3rem;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--info) 28%, var(--border));
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--info) 10%, transparent);
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--info);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--foreground);
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 2.25rem;
      line-height: 1.05;
    }
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 2.75rem;
    }
  }

  .muted {
    color: var(--muted-foreground);
  }

  .accent {
    width: 4rem;
    height: 0.25rem;
    margin-top: 1.25rem;
    border-radius: 999px;
    background: var(--primary);
  }

  .lede {
    margin: 1.25rem 0 0;
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .note {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
