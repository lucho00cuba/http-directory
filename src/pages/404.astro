---
import CategoryIcon from "../components/CategoryIcon.astro";
import DocsLayout from "../layouts/DocsLayout.astro";
import { withBase } from "../lib/site";
---

<DocsLayout
  title="404 Not Found"
  description="This page does not exist."
  canonical="/404"
>
  <article class="page">
    <div class="badge">
      <CategoryIcon name="clientError" class="size-3.5 text-client-error" />
      <span class="badge-label">Client Error</span>
    </div>
    <h1>
      <span class="code">404</span>
      <span>Not Found</span>
    </h1>
    <div class="accent"></div>
    <p>
      That page isn’t here. Browse the
      <a href={withBase()}>status code directory</a>
      or try a short URL like
      <code>/status/404</code>.
    </p>
    <a class="back" href={withBase()}>
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>
      </svg>
      Back to directory
    </a>
  </article>
</DocsLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 1rem 1.25rem;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .page {
      padding: 3.5rem 2.5rem 2rem;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--client-error);
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--client-error) 10%, transparent);
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--client-error);
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.65rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--foreground);
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 2.25rem;
      gap: 0.25rem 1rem;
      line-height: 1.05;
    }
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 2.75rem;
    }
  }

  .code {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--client-error);
  }

  .accent {
    width: 4rem;
    height: 0.25rem;
    margin: 1.25rem 0;
    border-radius: 999px;
    background: var(--client-error);
  }

  p {
    margin: 0;
    max-width: 32rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  p a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(
      in oklab,
      var(--foreground) 55%,
      transparent
    );
    text-underline-offset: 0.2em;
    transition: text-decoration-color 150ms ease;
  }

  p a:hover {
    text-decoration-color: var(--foreground);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: var(--code-bg);
    color: var(--code-fg);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .back:hover {
    color: var(--foreground);
  }
</style>
