---
import { getCollection } from "astro:content";
import CategoryIcon from "../components/CategoryIcon.astro";
import DocsLayout from "../layouts/DocsLayout.astro";
import { site } from "../lib/site";
import {
  ACCENT_CLASSES,
  canonicalPath,
  groupByCategory,
  tagline,
} from "../lib/status";

const statuses = await getCollection("status");
const groups = groupByCategory(statuses);
const total = statuses.length;
---

<DocsLayout title={site.name} description={site.description} canonical="/">
  <div class="page">
    <section class="hero">
      <div class="badge">
        <span class="badge-label">{total} codes · 5 categories</span>
      </div>
      <h1>{site.tagline}</h1>
      <div class="accent"></div>
      <p class="lede">
        {site.description} Browse by category and read what each status code means
        in practice.
      </p>
    </section>

    <section class="overview">
      {
        groups.map(({ meta }) => {
          const accent = ACCENT_CLASSES[meta.accent];
          return (
            <a href={`#${meta.id}`} class="overview-card">
              <CategoryIcon name={meta.icon} class={`size-5 ${accent.text}`} />
              <div>
                <div class="overview-range">{meta.label}</div>
                <div class="overview-name">{meta.name}</div>
              </div>
            </a>
          );
        })
      }
    </section>

    <div class="sections">
      {
        groups.map(({ meta, entries }) => {
          const accent = ACCENT_CLASSES[meta.accent];
          return (
            <section class="category" id={meta.id}>
              <div class="cat-head">
                <span class:list={["cat-icon", accent.softBg]}>
                  <CategoryIcon
                    name={meta.icon}
                    class={`size-5 ${accent.text}`}
                  />
                </span>
                <div>
                  <h2>
                    <span class:list={["range", accent.text]}>
                      {meta.label}
                    </span>{" "}
                    {meta.name}
                  </h2>
                  <p class="blurb">{meta.blurb}</p>
                </div>
              </div>

              <div class="cards">
                {entries.map((entry) => (
                  <a class="card" href={canonicalPath(entry)}>
                    <div class="card-main">
                      <div class="card-title">
                        <span class:list={["code", accent.text]}>
                          {entry.data.code}
                        </span>
                        <span class="name">{entry.data.title}</span>
                      </div>
                      <p class="hint">{tagline(entry)}</p>
                    </div>
                    <svg
                      class="arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</DocsLayout>

<style>
  .page {
    max-width: var(--content-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 1rem 1.25rem;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .page {
      padding: 3.5rem 2.5rem 2rem;
    }
  }

  .hero {
    margin-bottom: 2.25rem;
  }

  @media (min-width: 768px) {
    .hero {
      margin-bottom: 3rem;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--surface-container);
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 2.5rem;
      line-height: 1.05;
    }
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 3.25rem;
    }
  }

  .accent {
    width: 4rem;
    height: 0.25rem;
    margin-top: 1.25rem;
    border-radius: 999px;
    background: var(--primary);
  }

  .lede {
    margin: 1.25rem 0 0;
    max-width: 42rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .overview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .overview {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .overview {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .overview-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .overview-card:hover {
    background: var(--surface-container-high);
  }

  .overview-card:focus-visible {
    background: var(--surface-container-high);
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .overview-range {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .overview-name {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .category {
    scroll-margin-top: 6rem;
  }

  .cat-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .cat-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.125rem;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .range {
    font-family: var(--font-mono);
  }

  .blurb {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .card:hover {
    background: var(--surface-container-high);
  }

  .card:focus-visible {
    background: var(--surface-container-high);
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .card:hover .arrow,
  .card:focus-visible .arrow {
    transform: translateX(2px);
  }

  .card-main {
    min-width: 0;
  }

  .card-title {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
    color: var(--foreground);
  }

  .hint {
    margin: 0.25rem 0 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .arrow {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--muted-foreground);
    transition: transform 0.15s ease;
  }
</style>
