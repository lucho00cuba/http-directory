---
import type { StatusEntry } from "../lib/status";
import { canonicalPath } from "../lib/status";
import { buildSearchIndex } from "../lib/search";

interface Props {
  statuses: StatusEntry[];
  variant: "trigger" | "modal";
}

const { statuses, variant } = Astro.props;

const index =
  variant === "modal" ? buildSearchIndex(statuses, canonicalPath) : [];
---

{
  variant === "trigger" && (
    <div class="site-search" data-site-search>
      <button
        type="button"
        class="search-trigger"
        data-search-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-search-dialog"
      >
        <svg
          class="search-trigger-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="search-trigger-label">Search</span>
        <kbd class="search-kbd" aria-hidden="true">
          <span data-search-mod>⌘</span>K
        </kbd>
      </button>
    </div>
  )
}

{
  variant === "modal" && (
    <>
      <div
        id="site-search-dialog"
        class="search-dialog"
        data-search-dialog
        transition:persist="site-search-dialog"
        hidden
        role="dialog"
        aria-modal="true"
        aria-labelledby="site-search-title"
      >
        <script
          type="application/json"
          data-search-index
          is:inline
          set:html={JSON.stringify(index).replaceAll("<", "\\u003c")}
        />
        <div class="search-backdrop" data-search-close tabindex="-1" />
        <div class="search-panel" data-search-panel>
          <h2 id="site-search-title" class="sr-only">
            Search status codes
          </h2>
          <div class="search-input-row">
            <svg
              class="search-input-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              type="search"
              class="search-input"
              data-search-input
              placeholder="Search status codes…"
              aria-label="Search status codes"
              aria-autocomplete="list"
              aria-controls="site-search-results"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="go"
            />
            <kbd class="search-esc" aria-hidden="true">
              Esc
            </kbd>
          </div>
          <div
            id="site-search-results"
            class="search-results"
            data-search-results
            role="listbox"
            aria-label="Search results"
          />
          <p class="search-empty" data-search-empty hidden>
            No results found.
          </p>
          <p class="search-hint" data-search-hint>
            Type a code, name, or any word from the guides.
          </p>
          <div class="search-footer" data-search-footer hidden>
            <span>
              <>
                <kbd>↑</kbd>
                <kbd>↓</kbd>
              </>{" "}
              navigate
            </span>
            <span>
              <kbd>↵</kbd> open
            </span>
            <span>
              <kbd>esc</kbd> close
            </span>
          </div>
        </div>
      </div>
    </>
  )
}

{variant === "modal" && <script>import "../scripts/site-search";</script>}
