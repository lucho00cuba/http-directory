---
import type { StatusEntry } from "../lib/status";
import { canonicalPath, displayTitle, tagline } from "../lib/status";

interface Props {
  entries: StatusEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="see-also">
      <h2 id="see-also">See also</h2>
      <div class="grid">
        {entries.map((entry) => (
          <a class="card" href={canonicalPath(entry)}>
            <span class="body">
              <span class="title">{displayTitle(entry)}</span>
              <span class="desc">{tagline(entry)}</span>
            </span>
            <svg
              class="chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .see-also {
    margin: 2.25rem 0;
  }

  @media (min-width: 768px) {
    .see-also {
      margin: 3.5rem 0;
    }
  }

  h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--foreground);
  }

  @media (min-width: 768px) {
    h2 {
      margin: 0 0 1rem;
      font-size: 1.25rem;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.625rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  @media (min-width: 768px) {
    .card {
      gap: 1rem;
      padding: 1rem;
    }
  }

  .card:hover {
    background: var(--surface-container-high);
  }

  .card:focus-visible {
    background: var(--surface-container-high);
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .card:hover .chevron,
  .card:focus-visible .chevron {
    transform: translateX(2px);
  }

  .body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--foreground);
  }

  @media (min-width: 768px) {
    .title {
      font-size: 0.875rem;
    }
  }

  .desc {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .desc {
      font-size: 0.875rem;
    }
  }

  .chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--muted-foreground);
    transition: transform 0.15s ease;
  }
</style>
