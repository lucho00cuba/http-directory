---
import { withBase } from "../lib/site";
import {
  ACCENT_CLASSES,
  CATEGORY_META,
  type StatusCategory,
} from "../lib/status";
import CategoryIcon from "./CategoryIcon.astro";

interface Props {
  code: number;
  title: string;
  category: StatusCategory;
  summary?: string;
  updated?: string;
}

const { code, title, category, summary, updated } = Astro.props;
const meta = CATEGORY_META[category];
const accent = ACCENT_CLASSES[meta.accent];
---

<header class="header">
  <a
    href={withBase(`#${meta.id}`)}
    class:list={["badge", accent.border, accent.softBg]}
  >
    <CategoryIcon name={meta.icon} class={`size-3.5 ${accent.text}`} />
    <span class:list={["badge-label", accent.text]}>{meta.name}</span>
  </a>

  <h1>
    <span class:list={["code", accent.text]}>{code}</span>
    <span>{title}</span>
  </h1>
  <div class:list={["accent", accent.bg]}></div>

  {summary && <p class="summary">{summary}</p>}
  {
    updated && (
      <p class="meta">
        <em>Last updated</em>: {updated}
      </p>
    )
  }
</header>

<style>
  .header {
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .header {
      margin-bottom: 3rem;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid;
    border-radius: 0.375rem;
    text-decoration: none;
    transition: filter 0.15s ease;
  }

  .badge:hover {
    filter: brightness(0.97);
  }

  .badge:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .badge-label {
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
    }
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.65rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--foreground);
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 2.25rem;
      gap: 0.25rem 1rem;
      line-height: 1.05;
    }
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 2.75rem;
    }
  }

  .code {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .accent {
    width: 3rem;
    height: 0.2rem;
    margin-top: 0.85rem;
    border-radius: 999px;
  }

  @media (min-width: 768px) {
    .accent {
      width: 4rem;
      height: 0.25rem;
      margin-top: 1.25rem;
    }
  }

  .summary {
    margin: 1rem 0 0;
    max-width: 42rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .summary {
      margin: 1.25rem 0 0;
      font-size: 1.125rem;
      line-height: 1.65;
    }
  }

  .meta {
    margin: 0.65rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .meta {
      margin: 0.85rem 0 0;
      font-size: 0.875rem;
    }
  }
</style>
