---
import { ClientRouter } from "astro:transitions";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import {
  absoluteUrl,
  pageTitle,
  site,
  websiteJsonLd,
  withBase,
} from "@/lib/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = site.description,
  canonical,
  ogType = "website",
} = Astro.props;

const fullTitle = pageTitle(title);
const canonicalURL = canonical
  ? absoluteUrl(canonical)
  : new URL(Astro.url.pathname, site.origin);
const ogImage = absoluteUrl(site.assets.ogImage);
const jsonLd = websiteJsonLd();
---

<!doctype html>
<html lang={site.language} class="light" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase(site.assets.faviconSvg)}
    />
    <link rel="icon" href={withBase(site.assets.faviconIco)} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase(site.assets.appleTouchIcon)} />
    <link rel="manifest" href={withBase(site.assets.manifest)} />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.og.imageAlt} />
    <meta property="og:image:width" content={String(site.og.imageWidth)} />
    <meta property="og:image:height" content={String(site.og.imageHeight)} />

    <meta name="twitter:card" content={site.og.twitterCard} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.og.imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="abbr-tooltip" data-abbr-tooltip role="tooltip" hidden></div>
    <slot />
  </body></html
>

<script>
  let abbrScrollBound = false;

  document.addEventListener("astro:after-swap", () => {
    const hash = window.location.hash;
    if (hash) {
      const target = document.querySelector(hash);
      if (target instanceof HTMLElement) {
        target.scrollIntoView();
        return;
      }
    }
    window.scrollTo({ top: 0, left: 0 });
  });

  document.addEventListener("astro:page-load", () => {
    enhanceAbbrTooltips();
    enhanceHeadingLinks();
  });

  function enhanceHeadingLinks() {
    document
      .querySelectorAll<HTMLElement>("#main-content article :is(h2, h3)[id]")
      .forEach((heading) => {
        if (heading.dataset.headingLink === "1") return;
        if (heading.classList.contains("sr-only")) return;
        if (heading.querySelector(":scope > a.heading-permalink")) {
          heading.dataset.headingLink = "1";
          return;
        }

        const id = heading.id;
        if (!id) return;

        heading.dataset.headingLink = "1";

        const link = document.createElement("a");
        link.href = `#${id}`;
        link.className = "heading-permalink";

        while (heading.firstChild) {
          link.appendChild(heading.firstChild);
        }
        heading.appendChild(link);
      });
  }

  function enhanceAbbrTooltips() {
    const tip = document.querySelector<HTMLElement>("[data-abbr-tooltip]");
    if (!tip) return;
    if (!tip.id) tip.id = "abbr-tooltip";

    const hide = () => {
      const forId = tip.dataset.for;
      if (forId) {
        document.getElementById(forId)?.removeAttribute("aria-describedby");
        delete tip.dataset.for;
      }
      tip.hidden = true;
      tip.textContent = "";
    };

    const place = (anchor: HTMLElement) => {
      const rect = anchor.getBoundingClientRect();
      const tipRect = tip.getBoundingClientRect();
      const gap = 8;
      let left = rect.left + rect.width / 2 - tipRect.width / 2;
      left = Math.max(8, Math.min(left, window.innerWidth - tipRect.width - 8));
      let top = rect.top - tipRect.height - gap;
      if (top < 8) top = rect.bottom + gap;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };

    const show = (anchor: HTMLElement) => {
      const text = anchor.dataset.tip || anchor.getAttribute("title");
      if (!text) return;
      if (!anchor.id) {
        anchor.id = `abbr-${Math.random().toString(36).slice(2, 9)}`;
      }
      tip.textContent = text;
      tip.hidden = false;
      tip.dataset.for = anchor.id;
      anchor.setAttribute("aria-describedby", tip.id);
      place(anchor);
    };

    document
      .querySelectorAll<HTMLElement>("abbr[title], abbr[data-tip]")
      .forEach((el) => {
        if (el.dataset.tipReady === "1") return;
        el.dataset.tipReady = "1";
        const text = el.getAttribute("title") || el.dataset.tip;
        if (!text) return;
        el.dataset.tip = text;
        // Keep native title for AT; hide it while custom tip is open to avoid double tooltips

        el.addEventListener("pointerenter", () => {
          el.removeAttribute("title");
          show(el);
        });
        el.addEventListener("pointerleave", () => {
          el.setAttribute("title", text);
          hide();
        });
      });

    if (!abbrScrollBound) {
      abbrScrollBound = true;
      window.addEventListener("scroll", hide, { passive: true });
    }
  }
</script>

<style is:global>
  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.5rem 0.85rem;
    border-radius: 0.375rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform 0.15s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .abbr-tooltip {
    position: fixed;
    z-index: 300;
    max-width: min(18rem, calc(100vw - 1.5rem));
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  .abbr-tooltip[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
